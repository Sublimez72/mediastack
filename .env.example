# Copy to .env and fill in. Only the REQUIRED block is mandatory.
# Everything else (API keys, inter-app wiring, Plex token, passwords) is
# generated or discovered by stack-init on first `docker compose up -d`.

# ------------------------------------------------------------------ REQUIRED
# VPN for qBittorrent (gluetun). Provider list + per-provider notes:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=protonvpn
WIREGUARD_PRIVATE_KEY=

# Claim token for a NEW Plex server: https://plex.tv/claim (valid 4 minutes —
# grab it right before the first `docker compose up -d`). Not needed once claimed.
PLEX_CLAIM=

# ------------------------------------------------------------------ OPTIONAL
# Where your media + downloads live. Downloads and media MUST be on the same
# mount so imports are instant hardlinks instead of copies.
#MEDIA_ROOT=./library

#TZ=UTC
#PUID=1000
#PGID=1000

# One login shared by every web UI (Sonarr, Radarr, Prowlarr, Bazarr,
# qBittorrent, Tautulli). Leave blank to generate one; it is written to
# config/stack/credentials.env.
#ADMIN_USER=admin
#ADMIN_PASSWORD=

# Interface the web UIs listen on. 127.0.0.1 = this machine only.
# Use 0.0.0.0 to reach them from other devices on your LAN.
#BIND_ADDR=127.0.0.1

# Plex: your server's LAN address, so local clients stream directly instead of
# through Plex's relay. Example: http://192.168.1.50:32400
#PLEX_ADVERTISE_URL=

# VPN extras (provider dependent)
#WIREGUARD_ADDRESSES=        # "Address" line of your WireGuard config; needed by Mullvad, AirVPN, Surfshark, Windscribe, IVPN
#WIREGUARD_PRESHARED_KEY=    # "PresharedKey" line; needed by AirVPN, Windscribe
#VPN_SERVER_COUNTRIES=
#VPN_PORT_FORWARDING=on      # ProtonVPN / PIA / PrivateVPN / Perfect Privacy
#VPN_PORT_FORWARD_ONLY=on    # ProtonVPN / PIA: only pick port-forwarding servers

# Subtitles (Bazarr). Free account at opensubtitles.com
#OPENSUBTITLES_USERNAME=
#OPENSUBTITLES_PASSWORD=

# Remote access to Seerr — pick ONE profile (or none):
#   tailscale  : free, no domain, private to people you invite
#   cloudflare : needs your own domain on Cloudflare
#COMPOSE_PROFILES=tailscale
#TS_AUTHKEY=
#TS_HOSTNAME=mediastack
#CLOUDFLARE_TUNNEL_TOKEN=

# Hardware transcoding for Plex (needs Plex Pass). Windows uses ';' as the
# separator, Linux/macOS use ':'.
#COMPOSE_FILE=compose.yml;compose.gpu-nvidia.yml
#COMPOSE_FILE=compose.yml:compose.gpu-intel.yml
